# Registry-image override for docker-compose.yml. Keep populated files private.
# Use --env-file with both Compose files and a separate project name.
DOCKER_REGISTRY_USER=
IMAGE_TAG=

# Use fresh independent credentials for this stack.
DB_PASSWORD=
LOG_LAYER_DB_PASSWORD=
JWT_SECRET=
INTERNAL_API_KEY=
# Exactly 32 random bytes encoded as 64 hex characters.
SLACK_WEBHOOK_ENCRYPTION_KEY=

ACTIVE_MODEL=v2
RAG_SYNCHRONIZE_ON_START=false
