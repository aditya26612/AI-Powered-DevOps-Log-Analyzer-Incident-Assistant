# ==============================================================================
# DevInsight - Production Environment Configuration
# ==============================================================================

# Docker Hub Registry & Image Tag
DOCKER_REGISTRY_USER=adityagoku12
IMAGE_TAG=latest

# PostgreSQL Production Credentials
POSTGRES_USER=postgres
DB_PASSWORD=replace_with_strong_production_password_here
DB_PORT=5432

# Security & Secrets (Must be at least 32 characters)
JWT_SECRET=replace_with_at_least_32_characters_random_hex_or_string_in_production!
INTERNAL_API_KEY=replace_with_strong_internal_ml_service_key_in_production!

# Ollama Inference Runtime (Use containerized or host Ollama)
OLLAMA_BASE_URL=http://ollama:11434
