# ==============================================================================
# DevInsight - Environment Configuration
# ==============================================================================

# PostgreSQL Configuration
# Set your actual local PostgreSQL password here
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# JWT Authentication Secret (Must be at least 256 bits / 32 characters)
JWT_SECRET=devinsight_super_secret_jwt_key_2026_at_least_32_characters_long!

# Internal ML Pipeline Secret Key
INTERNAL_API_KEY=devinsight_internal_ml_key_secret_12345

# Ollama Local Runtime
OLLAMA_BASE_URL=http://localhost:11434

# Inter-Service URLs
USER_SERVICE_URL=http://localhost:8081
LOG_SERVICE_URL=http://localhost:8082
ML_SERVICE_URL=http://localhost:8000
LLM_SERVICE_URL=http://localhost:8084

