# ==============================================================================
# DevInsight - Environment Configuration Template
# ==============================================================================
# Instructions:
# For local Windows development, run: .\scripts\setup-local-env.ps1
# That script will automatically generate .env.local with secure random secrets
# and configure your local PostgreSQL credentials without manual copy-pasting.
#
# DO NOT commit .env or .env.local to source control.
# ==============================================================================

# ==============================================================================
# 1. REQUIRED CONFIGURATION (Must be configured in all environments)
# ==============================================================================

# PostgreSQL Database Configuration
# Local default user is 'postgres'. In production, supply a dedicated service account.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=replace_with_your_actual_postgres_password

# Restricted Log Layer runtime login. The container runbook describes provisioning.
LOG_LAYER_DB_USERNAME=devinsight_log_app
LOG_LAYER_DB_PASSWORD=

# Persistent 32-byte Slack encryption key encoded as 64 hexadecimal characters.
SLACK_WEBHOOK_ENCRYPTION_KEY=

# JWT Signing Secret Key (Must be at least 256 bits / 32 characters long)
# Used for HMAC-SHA256 signing of user session tokens across Gateway and User Service.
# Auto-generated by scripts/setup-local-env.ps1 for local environments.
JWT_SECRET=replace_with_at_least_32_characters_random_hex_or_string_key

# Internal Service-to-Service API Key (Must be at least 16 characters long)
# Used for authenticated inter-service communication between Gateway, Log Layer, and ML Pipeline.
# Auto-generated by scripts/setup-local-env.ps1 for local environments.
INTERNAL_API_KEY=replace_with_at_least_32_characters_random_hex_internal_key

# ==============================================================================
# 2. MACHINE LEARNING & RUNTIME CONFIGURATION
# ==============================================================================

# Active Anomaly Detection Model Architecture
# Supported values:
#   v2 - CuratedIsolationForest (40 features, threshold -0.02, no scaler) [DEFAULT]
#   v1 - Legacy IsolationForest (41 features, threshold 0.0, StandardScaler rollback)
ACTIVE_MODEL=v2

# Set true for initial indexing of a fresh vector store after model provisioning.
RAG_SYNCHRONIZE_ON_START=false

# Local Ollama Daemon Base URL
# Default local port is 11434. Models: phi3:mini (chat) and nomic-embed-text:latest (embeddings).
OLLAMA_BASE_URL=http://localhost:11434

# Deployment Environment Name (development / staging / production)
ENVIRONMENT=development

# ==============================================================================
# 3. INTER-SERVICE ROUTING URLs (Reverse Proxy Routing)
# ==============================================================================
USER_SERVICE_URL=http://localhost:8081
LOG_SERVICE_URL=http://localhost:8082
ML_SERVICE_URL=http://localhost:8000
LLM_SERVICE_URL=http://localhost:8084

# ==============================================================================
# 4. OPTIONAL INTEGRATIONS (Incident Notifications)
# ==============================================================================

# Automated LLM Root-Cause Diagnosis on Anomaly / Error Logs
NOTIFICATION_AUTO_DIAGNOSE=true

# Slack Webhook Alerts
# KEEP DISABLED (false) in local development to avoid firing real external alerts.
NOTIFICATION_SLACK_ENABLED=false
NOTIFICATION_SLACK_WEBHOOK_URL=
NOTIFICATION_SLACK_CHANNEL=#all-devinsight

# Email Notifications
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_EMAIL_TO=
